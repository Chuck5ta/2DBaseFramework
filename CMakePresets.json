{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "description": "Validation layers on, console logging, no optimisation",
      "inherits": "ninja-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Optimised + debug info (Ninja)",
      "description": "For profiling (RenderDoc, Nsight, Tracy, perf)",
      "inherits": "ninja-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "description": "Shipping build; no console window on Windows",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GAME_WINDOWS_CONSOLE": "OFF"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 solution",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 solution",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "release", "configurePreset": "release" }
  ]
}
